var score:int = 100
var bonus:int = 25
var multiplier:int = 2

.start:
    outln "Arithmetic Test"

    add score = bonus
    outln score

    sub score = 5
    outln score

    mul score = multiplier
    outln score

    div score = 2
    outln score

    mod score = 7
    outln score

    inc score
    outln score

    dec score
    outln score

    neg score
    outln score

    halt
