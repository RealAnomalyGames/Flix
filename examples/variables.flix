.start:
    var player:str = "John Doe"
    var score:int = 500
    var speed:float = 4.5
    var alive:bool = true

    outln player
    outln score
    outln speed
    outln alive

    mov score, 1000
    mov speed, 8.5
    mov alive, false

    outln score
    outln speed
    outln alive

    halt 0
